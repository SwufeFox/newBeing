{
  "name": "@newbeing/market-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./utils": { "types": "./src/utils.ts", "import": "./dist/utils.js", "default": "./dist/utils.js" },
    "./types": { "types": "./src/types.ts", "import": "./dist/types.js", "default": "./dist/types.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": { "ccxt": "4.5.85", "@newbeing/core": "workspace:*" },
  "devDependencies": { "vitest": "^5.0.3", "typescript": "5.9.3" }
}
