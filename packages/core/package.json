{
  "name": "@newbeing/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./backtest": {
      "types": "./src/backtest.ts",
      "import": "./dist/backtest.js",
      "default": "./dist/backtest.js"
    },
    "./strategies": {
      "types": "./src/strategies.ts",
      "import": "./dist/strategies.js",
      "default": "./dist/strategies.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "bench": "pnpm build && node --expose-gc bench/backtest.mjs"
  },
  "dependencies": {
    "zod": "^4.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
