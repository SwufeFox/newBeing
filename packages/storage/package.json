{
  "name": "@newbeing/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    "./derivatives": { "types": "./src/derivatives.ts", "import": "./dist/derivatives.js", "default": "./dist/derivatives.js" },
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@newbeing/core": "workspace:*",
    "better-sqlite3": "12.6.2",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
